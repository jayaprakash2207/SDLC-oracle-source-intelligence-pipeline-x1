    "menu_module": "HRMS_MENU",
    "libraries": [
      "HRMS_COMMON_LIB"
    ],
    "form_triggers": [
      {
        "name": "WHEN-NEW-FORM-INSTANCE",
        "style": "PL/SQL",
        "body": "BEGIN\n    -- Session validation\n    IF NOT PKG_SECURITY.is_session_valid(\n        TO_NUMBER(GET_APPLICATION_PROPERTY(USERNAME))) THEN\n        MESSAGE('Session expired.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    SET_WINDOW_PROPERTY(FORMS_MDI_WINDOW, TITLE,\n        'HRMS - Leave Management [' || :GLOBAL.current_user || ']');\n\n    -- Show current user's leave requests by default\n    SET_BLOCK_PROPERTY('LEAVE_REQUEST', DEFAULT_WHERE,\n        'EMP_ID = ' || :GLOBAL.current_emp_id || ' ORDER BY CREATED_DATE DESC');\n\n    -- Populate leave type LOV\n    POPULATE_GROUP('RG_LEAVE_TYPES');\n\n    GO_BLOCK('LEAVE_REQUEST');\n    EXECUTE_QUERY;\n\n    -- Show leave balances\n    GO_BLOCK('LEAVE_BALANCE');\n    EXECUTE_QUERY;\n    GO_BLOCK('LEAVE_REQUEST');\nEND;",
        "pkg_calls": [
          "PKG_SECURITY.is_session_valid"
        ],
        "business_rules": [],
        "rules": [],
        "raise_errors": []
      }
    ],
