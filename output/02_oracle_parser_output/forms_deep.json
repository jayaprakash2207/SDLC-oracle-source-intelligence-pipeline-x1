    "name": "HRMS_EMPLOYEE",
    "file": "HRMS_EMPLOYEE.xml",
    "title": "HRMS - Employee Maintenance",
    "first_block": "EMPLOYEE",
    "menu_module": "HRMS_MENU",
    "libraries": [
      "HRMS_COMMON_LIB",
