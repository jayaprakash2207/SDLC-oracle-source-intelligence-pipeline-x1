    "form_triggers": [
      {
        "name": "WHEN-NEW-FORM-INSTANCE",
        "style": "PL/SQL",
        "body": "DECLARE\n    v_session_id NUMBER;\nBEGIN\n    -- Validate session\n    v_session_id := TO_NUMBER(GET_APPLICATION_PROPERTY(USERNAME));\n    IF NOT PKG_SECURITY.is_session_valid(v_session_id) THEN\n        MESSAGE('Session expired. Please log in again.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    -- Set window title\n    SET_WINDOW_PROPERTY(FORMS_MDI_WINDOW, TITLE,\n        'HRMS - Employee Maintenance [' || :GLOBAL.current_user || ']');\n\n    -- Restrict based on permissions\n    IF NOT PKG_SECURITY.has_permission(:GLOBAL.current_emp_id, 'EMPLOYEE', 'EDIT') THEN\n        SET_BLOCK_PROPERTY('EMPLOYEE', INSERT_ALLOWED, PROPERTY_FALSE);\n        SET_BLOCK_PROPERTY('EMPLOYEE', UPDATE_ALLOWED, PROPERTY_FALSE);\n        SET_BLOCK_PROPERTY('EMPLOYEE', DELETE_ALLOWED, PROPERTY_FALSE);\n    END IF;\n\n    -- Default query to active employees\n    SET_BLOCK_PROPERTY('EMPLOYEE', DEFAULT_WHERE,\n        'EMPLOYMENT_STATUS = ''ACTIVE'' AND ACTIVE_FLAG = ''Y''');\n\n    -- Initialize LOVs\n    POPULATE_GROUP('RG_DEPARTMENTS');\n    POPULATE_GROUP('RG_JOB_TITLES');\n    POPULATE_GROUP('RG_LOCATIONS');\n\n    GO_BLOCK('EMPLOYEE');\n    EXECUTE_QUERY;\nEND;",
        "pkg_calls": [
          "PKG_SECURITY.has_permission",
          "PKG_SECURITY.is_session_valid"
        ],
        "business_rules": [],
        "rules": [],
        "raise_errors": []
      },
      {
        "name": "ON-ERROR",
        "style": "PL/SQL",
        "body": "DECLARE\n    v_errcode NUMBER := ERROR_CODE;\n    v_errtype VARCHAR2(3) := ERROR_TYPE;\n    v_errmsg  VARCHAR2(200) := ERROR_TEXT;\nBEGIN\n    IF v_errcode = 40202 THEN\n        -- \"Field is protected against update\"\n        NULL; -- Suppress\n    ELSIF v_errcode = 40401 THEN\n        -- \"No changes to save\"\n        MESSAGE('No changes to save.');\n    ELSIF v_errcode = 40501 THEN\n        -- \"Oracle error: unable to reserve record\"\n        MESSAGE('Record is locked by another user. Please try again.');\n    ELSE\n        MESSAGE(v_errtype || '-' || TO_CHAR(v_errcode) || ': ' || v_errmsg);\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\nEND;",
        "pkg_calls": [],
        "business_rules": [],
        "rules": [],
        "raise_errors": []
      },
      {
        "name": "KEY-EXIT",
        "style": "PL/SQL",
        "body": "BEGIN\n    IF :SYSTEM.FORM_STATUS = 'CHANGED' THEN\n        IF SHOW_ALERT('ALT_CONFIRM_EXIT') = ALERT_BUTTON1 THEN\n            COMMIT_FORM;\n        ELSIF SHOW_ALERT('ALT_CONFIRM_EXIT') = ALERT_BUTTON2 THEN\n            CLEAR_FORM(NO_VALIDATE);\n        ELSE\n            RAISE FORM_TRIGGER_FAILURE;\n        END IF;\n    END IF;\n    EXIT_FORM;\nEND;",
        "pkg_calls": [],
        "business_rules": [],
        "rules": [],
        "raise_errors": []
      }
    ],
