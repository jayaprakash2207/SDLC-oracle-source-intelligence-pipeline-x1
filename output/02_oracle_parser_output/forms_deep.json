        "triggers": [
          {
            "name": "PRE-INSERT",
            "body": "BEGIN\n    :EMPLOYEE.EMP_ID := SEQ_EMPLOYEE.NEXTVAL;\n    :EMPLOYEE.EMP_NUMBER := PKG_EMPLOYEE.generate_emp_number;\n    :EMPLOYEE.ACTIVE_FLAG := 'Y';\n    :EMPLOYEE.EMPLOYMENT_STATUS := 'ACTIVE';\n    :EMPLOYEE.CREATED_BY := :GLOBAL.current_user;\n    :EMPLOYEE.CREATED_DATE := SYSDATE;\nEND;",
            "pkg_calls": [
              "PKG_EMPLOYEE.generate_emp_number"
            ],
            "business_rules": [],
            "raise_errors": []
          },
          {
            "name": "PRE-UPDATE",
            "body": "BEGIN\n    :EMPLOYEE.MODIFIED_BY := :GLOBAL.current_user;\n    :EMPLOYEE.MODIFIED_DATE := SYSDATE;\nEND;",
            "pkg_calls": [],
            "business_rules": [],
            "raise_errors": []
          },
          {
            "name": "POST-QUERY",
            "body": "BEGIN\n    -- Populate display items\n    BEGIN\n        SELECT DEPT_NAME INTO :EMPLOYEE.DEPT_NAME_DISP\n        FROM DEPARTMENTS WHERE DEPT_ID = :EMPLOYEE.DEPT_ID;\n    EXCEPTION WHEN NO_DATA_FOUND THEN :EMPLOYEE.DEPT_NAME_DISP := NULL;\n    END;\n\n    BEGIN\n        SELECT JOB_TITLE INTO :EMPLOYEE.JOB_TITLE_DISP\n        FROM JOB_TITLES WHERE JOB_ID = :EMPLOYEE.JOB_ID;\n    EXCEPTION WHEN NO_DATA_FOUND THEN :EMPLOYEE.JOB_TITLE_DISP := NULL;\n    END;\n\n    BEGIN\n        SELECT FIRST_NAME || ' ' || LAST_NAME INTO :EMPLOYEE.MANAGER_NAME_DISP\n        FROM EMPLOYEES WHERE EMP_ID = :EMPLOYEE.MANAGER_EMP_ID;\n    EXCEPTION WHEN NO_DATA_FOUND THEN :EMPLOYEE.MANAGER_NAME_DISP := NULL;\n    END;\nEND;",
            "pkg_calls": [],
            "business_rules": [],
            "raise_errors": []
          },
          {
            "name": "WHEN-VALIDATE-ITEM",
            "body": "DECLARE\n    v_item VARCHAR2(60) := :SYSTEM.TRIGGER_ITEM;\nBEGIN\n    IF v_item = 'EMPLOYEE.EMAIL' THEN\n        IF :EMPLOYEE.EMAIL IS NOT NULL\n           AND NOT PKG_VALIDATION.validate_email_format(:EMPLOYEE.EMAIL) THEN\n            MESSAGE('Invalid email format');\n            RAISE FORM_TRIGGER_FAILURE;\n        END IF;\n\n    ELSIF v_item = 'EMPLOYEE.HIRE_DATE' THEN\n        IF :EMPLOYEE.HIRE_DATE > SYSDATE + 90 THEN\n            MESSAGE('Hire date cannot be more than 90 days in the future');\n            RAISE FORM_TRIGGER_FAILURE;\n        END IF;\n\n    ELSIF v_item = 'EMPLOYEE.DEPT_ID' THEN\n        -- Auto-populate department name\n        BEGIN\n            SELECT DEPT_NAME INTO :EMPLOYEE.DEPT_NAME_DISP\n            FROM DEPARTMENTS\n            WHERE DEPT_ID = :EMPLOYEE.DEPT_ID AND ACTIVE_FLAG = 'Y';\n        EXCEPTION\n            WHEN NO_DATA_FOUND THEN\n                MESSAGE('Invalid department');\n                RAISE FORM_TRIGGER_FAILURE;\n        END;\n\n    ELSIF v_item = 'EMPLOYEE.JOB_ID' THEN\n        BEGIN\n            SELECT JOB_TITLE INTO :EMPLOYEE.JOB_TITLE_DISP\n            FROM JOB_TITLES\n            WHERE JOB_ID = :EMPLOYEE.JOB_ID AND ACTIVE_FLAG = 'Y';\n        EXCEPTION\n            WHEN NO_DATA_FOUND THEN\n                MESSAGE('Invalid job title');\n                RAISE FORM_TRIGGER_FAILURE;\n        END;\n    END IF;\nEND;",
            "pkg_calls": [
              "PKG_VALIDATION.validate_email_format"
            ],
            "business_rules": [],
            "raise_errors": []
          }
        ]
