        "body": "DECLARE\n    v_session_id NUMBER;\nBEGIN\n    v_session_id := TO_NUMBER(GET_APPLICATION_PROPERTY(USERNAME));\n    IF NOT PKG_SECURITY.is_session_valid(v_session_id) THEN\n        MESSAGE('Session expired. Please log in again.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    -- Payroll module requires elevated permissions\n    IF NOT PKG_SECURITY.has_permission(:GLOBAL.current_emp_id, 'PAYROLL', 'VIEW') THEN\n        MESSAGE('You do not have permission to access the Payroll module.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    SET_WINDOW_PROPERTY(FORMS_MDI_WINDOW, TITLE,\n        'HRMS - Payroll Processing [' || :GLOBAL.current_user || ']');\n\n    GO_BLOCK('PAY_PERIOD');\n    SET_BLOCK_PROPERTY('PAY_PERIOD', DEFAULT_WHERE,\n        'STATUS = ''OPEN'' ORDER BY PERIOD_START_DATE DESC');\n    EXECUTE_QUERY;\nEND;",
