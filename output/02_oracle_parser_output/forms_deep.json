          }
        ],
        "triggers": [
          {
            "name": "WHEN-BUTTON-PRESSED",
            "body": "BEGIN\n    IF :LEAVE_REQUEST.STATUS NOT IN ('PENDING', 'APPROVED') THEN\n        MESSAGE('Only pending or approved requests can be cancelled.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    IF SHOW_ALERT('ALT_CONFIRM_CANCEL') = ALERT_BUTTON1 THEN\n        PKG_LEAVE.cancel_leave_request(\n            :LEAVE_REQUEST.REQUEST_ID, 'Cancelled by employee', :GLOBAL.current_user);\n        MESSAGE('Leave request cancelled.');\n        EXECUTE_QUERY;\n    END IF;\nEND;",
            "pkg_calls": [
              "PKG_LEAVE.cancel_leave_request"
            ],
            "business_rules": [],
            "raise_errors": []
          },
          {
            "name": "POST-QUERY",
            "body": "BEGIN\n    SELECT lt.LEAVE_TYPE_NAME INTO :LEAVE_REQUEST.LEAVE_TYPE_NAME_DISP\n    FROM LEAVE_TYPES lt\n    JOIN LEAVE_REQUESTS lr ON lt.LEAVE_TYPE_ID = lr.LEAVE_TYPE_ID\n    WHERE lr.REQUEST_ID = :LEAVE_REQUEST.REQUEST_ID;\nEXCEPTION\n    WHEN NO_DATA_FOUND THEN\n        :LEAVE_REQUEST.LEAVE_TYPE_NAME_DISP := 'Unknown';\nEND;",
            "pkg_calls": [],
            "business_rules": [],
            "raise_errors": []
