        "triggers": [
          {
            "name": "WHEN-BUTTON-PRESSED",
            "body": "DECLARE\n    v_request_id NUMBER;\nBEGIN\n    -- Validate required fields\n    IF :NEW_REQUEST.NR_LEAVE_TYPE_ID IS NULL THEN\n        MESSAGE('Please select a leave type.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n    IF :NEW_REQUEST.NR_START_DATE IS NULL THEN\n        MESSAGE('Please enter a start date.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n    IF :NEW_REQUEST.NR_END_DATE IS NULL THEN\n        MESSAGE('Please enter an end date.');\n        RAISE FORM_TRIGGER_FAILURE;\n    END IF;\n\n    v_request_id := PKG_LEAVE.submit_leave_request(\n        p_emp_id        => :GLOBAL.current_emp_id,\n        p_leave_type_id => :NEW_REQUEST.NR_LEAVE_TYPE_ID,\n        p_start_date    => :NEW_REQUEST.NR_START_DATE,\n        p_end_date      => :NEW_REQUEST.NR_END_DATE,\n        p_half_day_flag => NVL(:NEW_REQUEST.NR_HALF_DAY, 'N'),\n        p_reason        => :NEW_REQUEST.NR_REASON,\n        p_user          => :GLOBAL.current_user\n    );\n\n    MESSAGE('Leave request #' || v_request_id || ' submitted successfully.');\n    CLEAR_BLOCK(NO_VALIDATE);\n\n    -- Refresh requests list\n    GO_BLOCK('LEAVE_REQUEST');\n    EXECUTE_QUERY;\nEND;",
            "pkg_calls": [
              "PKG_LEAVE.submit_leave_request"
            ],
            "business_rules": [],
