{
  "_comment": "Pipeline Configuration — Oracle HRMS Forward Engineering Pipeline",
  "_description": "Central configuration file for all pipeline settings. Edit this file to control model, timeouts, loop behaviour, and output paths.",

  "pipeline": {
    "name": "Oracle HRMS Forward Engineering Pipeline",
    "version": "2.0",
    "mode": "multiagent_self_healing",
    "_mode_options": ["sequential", "multiagent_self_healing"],
    "total_steps": 15
  },

  "claude": {
    "model": "",
    "_model_comment": "Leave empty to use CLI default. Override with env var: PIPELINE_CLAUDE_MODEL=claude-sonnet-4-6",
    "_model_options": [
      "claude-sonnet-4-6",
      "claude-opus-4-8",
      "claude-haiku-4-5-20251001"
    ],
    "output_format": "text",
    "session_persistence": false,
    "allow_tools": false
  },

  "foundation_runner": {
    "_description": "Controls the 25-document generation step (Step 14)",
    "runner": "foundation_runner_multiagent.py",
    "_runner_options": [
      "foundation_runner_template.py",
      "foundation_runner_multiagent.py"
    ],

    "phase1_parallel": true,
    "_phase1_comment": "Run Subagent A (docs 01-10) and Subagent B (docs 11-20) simultaneously",

    "self_healing_loop": {
      "enabled": true,
      "max_iterations": 3,
      "_max_iterations_comment": "Max times the gap hunter loop runs before escalating to HUMAN-DECISION-REQUIRED",
      "gap_hunter_enabled": true,
      "ba_fix_agent_enabled": true,
      "da_fix_agent_enabled": true,
      "sec_fix_agent_enabled": true
    },

    "self_correction": {
      "enabled": true,
      "_description": "Call 5 — re-examines LOW confidence sections and upgrades or confirms NOT_AVAILABLE"
    },

    "second_opinion_scoring": {
      "enabled": true,
      "_description": "Call 6 — independent review of HIGH confidence claims, flags potential downgrades"
    },

    "coverage_pass": {
      "enabled": true,
      "_description": "Python-verified evidence counts — overwrites Claude's semantic estimates with exact programmatic counts"
    },

    "final_quality_gate": {
      "enabled": true,
      "_description": "Phase 3 — sets YES / CONDITIONAL / NO-GO per document after self-healing loop completes"
    }
  },

  "timeouts_seconds": {
    "_description": "Per-call Claude timeouts. Increase if calls are timing out on slow machines.",
    "call1_generation_docs_01_10": 5400,
    "call2_generation_docs_11_20": 5400,
    "call3_template_compliance": 5400,
    "call4_consistency_check": 5400,
    "call5_self_correction": 3600,
    "call6_second_opinion": 2400,
    "gap_hunter_per_iteration": 3600,
    "domain_fix_agent_per_iteration": 3600,
    "final_quality_gate": 3600
  },

  "retry": {
    "max_retries": 5,
    "retry_wait_seconds": 30,
    "_description": "How many times to retry a failed Claude call before giving up"
  },

  "output": {
    "foundation_subdir": "Foundation_KnowledgeGraph",
    "forward_engineering_subdir": "ForwardEngineering_Docs",
    "raw_outputs": {
      "part1": "Foundation_Raw_Output_Part1.md",
      "part2": "Foundation_Raw_Output_Part2.md",
      "part3": "Foundation_Raw_Output_Part3.md",
      "part4": "Foundation_Raw_Output_Part4.md",
      "part5_self_correction": "Foundation_Raw_Output_Part5.md",
      "part6_second_opinion": "Foundation_Raw_Output_Part6.md",
      "gap_hunter_pattern": "Gap_Hunter_Iteration_{N}.md",
      "domain_fix_pattern": "Fix_{DOMAIN}_Iteration_{N}.md",
      "human_decisions": "HUMAN_DECISION_REQUIRED.md",
      "quality_gate_report": "FINAL_QUALITY_GATE_REPORT.md",
      "coverage_summary": "COVERAGE_SUMMARY.md"
    }
  },

  "documents": {
    "_description": "The 25 documents generated by the foundation runner",
    "foundation_knowledge_graph": [
      "ENTERPRISE_KNOWLEDGE_GRAPH.json",
      "CANONICAL_ENTERPRISE_MODEL.md",
      "ARCHITECTURE_INVENTORY.md",
      "TRACEABILITY_MATRIX.md",
      "FORWARD_ENGINEERING_INPUT_MAP.md"
    ],
    "forward_engineering_docs": [
      "01_BRD.md",
      "02_BUSINESS_CAPABILITY_MODEL.md",
      "03_USE_CASE_SPECIFICATION.md",
      "04_BUSINESS_PROCESS_MODEL.md",
      "05_DOMAIN_MODEL.md",
      "06_DATA_DICTIONARY.md",
      "07_DATA_MODEL_SPECIFICATION.md",
      "08_ERD.md",
      "09_DATA_FLOW_DIAGRAM.md",
      "10_SERVICE_CATALOG.md",
      "11_API_CONTRACT_SPECIFICATION.md",
      "12_TECHNOLOGY_BLUEPRINT.md",
      "13_SECURITY_ARCHITECTURE.md",
      "14_NFR_SPECIFICATION.md",
      "15_FORWARD_ENGINEERING_SPECIFICATION.md",
      "16_GENERATION_MANIFEST.json",
      "17_FORWARD_ENGINEERING_READINESS_REPORT.md",
      "18_DEPLOYMENT_ARCHITECTURE.md",
      "19_FRONTEND_ARCHITECTURE.md",
      "20_UI_UX_SPECIFICATION.md"
    ]
  },

  "pipeline_steps": {
    "_description": "All 15 pipeline steps — matches run.py orchestrator",
    "steps": [
      { "step": 0,   "name": "Rule Annotator",       "track": "setup",       "runner": "rule_annotator_runner.py",    "timeout": 7200 },
      { "step": 1,   "name": "Layer 1",               "track": "setup",       "runner": "layer1",                      "timeout": 3600 },
      { "step": 2,   "name": "Scan Once",              "track": "setup",       "runner": "scan_runner.py",              "timeout": 3600 },
      { "step": 3,   "name": "Scan Agent",             "track": "setup",       "runner": "scan_agent_runner.py",        "timeout": 7200 },
      { "step": 3.5, "name": "Implicit Rules",         "track": "setup",       "runner": "implicit_rules_runner.py",    "timeout": 1800 },
      { "step": 4,   "name": "BA Agent 1",             "track": "business",    "runner": "ba_agent1_runner.py",         "timeout": 3600 },
      { "step": 5,   "name": "BA Agent 2",             "track": "business",    "runner": "ba_agent2_runner.py",         "timeout": 3600 },
      { "step": 6,   "name": "DA Agent 1",             "track": "data",        "runner": "da_agent1_runner.py",         "timeout": 3600 },
      { "step": 7,   "name": "DA Agent 2",             "track": "data",        "runner": "da_agent2_runner.py",         "timeout": 3600 },
      { "step": 8,   "name": "TA Agent 1",             "track": "technology",  "runner": "ta_agent1_runner.py",         "timeout": 3600 },
      { "step": 9,   "name": "TA Agent 2 Batch 1",     "track": "technology",  "runner": "ta_agent2_batch1_runner.py",  "timeout": 9000 },
      { "step": 10,  "name": "TA Agent 2 Batch 2",     "track": "technology",  "runner": "ta_agent2_batch2_runner.py",  "timeout": 14400 },
      { "step": 11,  "name": "AA Agent 1",             "track": "application", "runner": "aa_agent1_runner.py",         "timeout": 3600 },
      { "step": 12,  "name": "AA Agent 2",             "track": "application", "runner": "aa_agent2_runner.py",         "timeout": 3600 },
      { "step": 13,  "name": "Cross Validator",        "track": "validate",    "runner": "cross_validator_runner.py",   "timeout": 3600 },
      { "step": 14,  "name": "Foundation",             "track": "foundation",  "runner": "foundation_runner_multiagent.py", "timeout": 7200 },
      { "step": 15,  "name": "Gap Hunter",             "track": "foundation",  "runner": "gap_hunter_runner.py",        "timeout": 5400 }
    ],
    "tracks": {
      "setup":       { "steps": "1-3",   "parallel": false, "est_minutes": 30 },
      "business":    { "steps": "4-5",   "parallel": true,  "est_minutes": 30 },
      "data":        { "steps": "6-7",   "parallel": true,  "est_minutes": 30 },
      "technology":  { "steps": "8-10",  "parallel": true,  "est_minutes": 30 },
      "application": { "steps": "11-12", "parallel": true,  "est_minutes": 30 },
      "validate":    { "steps": "13",    "parallel": false,  "est_minutes": 15 },
      "foundation":  { "steps": "14-15", "parallel": false,  "est_minutes": 45 }
    }
  },

  "quality_gates": {
    "_description": "Evidence classification thresholds used across all documents",
    "evidence_classes": ["OBSERVED", "DERIVED", "INFERRED", "ASSUMED", "UNKNOWN", "CONTRADICTED"],
    "confidence_thresholds": {
      "HIGH":   { "min": 0.75, "max": 1.00 },
      "MEDIUM": { "min": 0.50, "max": 0.74 },
      "LOW":    { "min": 0.00, "max": 0.49 }
    },
    "readiness_thresholds": {
      "HIGH":   { "source_match_pct_min": 80 },
      "MEDIUM": { "source_match_pct_min": 60 },
      "LOW":    { "source_match_pct_min": 0  }
    },
    "verdicts": ["YES", "CONDITIONAL", "NO-GO"]
  },

  "technology_neutrality": {
    "_description": "Technology names that must NOT appear as prescribed targets in any generated document",
    "banned_as_target": [
      "React", "Angular", "Vue", "Next.js",
      "Node.js", "Express",
      "Spring Boot", "Django", "Rails", "FastAPI",
      "Kubernetes", "K8s", "Docker",
      "AWS", "Azure", "GCP",
      "PostgreSQL", "MySQL", "MongoDB",
      "JWT", "bcrypt", "Argon2", "scrypt",
      "Nginx", "Apache",
      "Kafka", "RabbitMQ"
    ],
    "allowed_as_source_facts": [
      "Oracle Forms 12c",
      "Oracle DB 19c",
      "PL/SQL",
      "DBMS_CRYPTO",
      "Oracle Forms 12.2.1.4"
    ]
  },

  "source_system": {
    "_description": "Oracle HRMS source system facts",
    "platform": "Oracle Forms 12c (12.2.1.4)",
    "database": "Oracle DB 19c",
    "language": "PL/SQL",
    "source_files_total": 42,
    "packages": 11,
    "business_rules": 826,
    "audit_checks": 3715,
    "tables": 30,
    "columns": 441,
    "views": 6,
    "sequences": 29,
    "triggers": 6,
    "forms": 6,
    "seed_rows": 133,
    "known_vulnerabilities": 4,
    "known_bugs": 20,
    "deferred_todos": 5
  }
}
